{
  "namespace": "org.muralis.datahose.avro",
  "type": "record",
  "name": "Claim",
  "doc": "Claims processing record",
  "fields": [
    {
      "name": "claimId",
      "type": "string",
      "doc": "Unique claim identifier"
    },
    {
      "name": "claimAmount",
      "type": "double",
      "doc": "Claim amount"
    },
    {
      "name": "claimDate",
      "type": "string",
      "doc": "Date of the claim"
    },
    {
      "name": "claimStatus",
      "type": "string",
      "doc": "Claim status (e.g., Approved, Pending, Denied)"
    },
    {
      "name": "eventTimestamp",
      "type": "long",
      "doc": "Event timestamp in milliseconds"
    },
    {
      "name": "year",
      "type": "int",
      "doc": "Partition field: year"
    },
    {
      "name": "month",
      "type": "int",
      "doc": "Partition field: month"
    },
    {
      "name": "day",
      "type": "int",
      "doc": "Partition field: day"
    },
    {
      "name": "hour",
      "type": "int",
      "doc": "Partition field: hour"
    }
  ]
}
